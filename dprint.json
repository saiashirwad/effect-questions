{
  "lineWidth": 100,
  "indentWidth": 2,
  "typescript": { "quoteStyle": "alwaysDouble", "semiColons": "always" },
  "includes": ["**/*.{ts,json,md}"],
  "excludes": ["node_modules", "dist", "pnpm-lock.yaml"],
  "plugins": [
    "https://plugins.dprint.dev/typescript-0.95.15.wasm",
    "https://plugins.dprint.dev/json-0.21.0.wasm",
    "https://plugins.dprint.dev/markdown-0.19.0.wasm"
  ]
}
