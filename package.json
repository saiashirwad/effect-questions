{
  "name": "effect-jev",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@11.20.0",
  "engines": {
    "node": ">=24"
  },
  "exports": {
    ".": "./src/index.ts"
  },
  "scripts": {
    "example": "node examples/main.ts",
    "build": "tsc -p tsconfig.build.json",
