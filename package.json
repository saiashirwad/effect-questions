{
  "name": "effect-questions",
  "version": "0.0.0",
  "private": true,
  "description": "Type-safe AI judgments and probabilistic control flow for Effect.",
  "type": "module",
  "packageManager": "pnpm@11.20.0",
  "engines": {
    "node": ">=24"
  },
  "exports": {
    ".": { "types": "./dist/index.d.ts", "import": "./dist/index.js" },
    "./Answer": { "types": "./dist/Answer.d.ts", "import": "./dist/Answer.js" },
    "./Decision": { "types": "./dist/Decision.d.ts", "import": "./dist/Decision.js" },
    "./Question": { "types": "./dist/Question.d.ts", "import": "./dist/Question.js" },
    "./QuestionModel": {
      "types": "./dist/QuestionModel.d.ts",
      "import": "./dist/QuestionModel.js"
    },
    "./providers/Jev": { "types": "./dist/providers/Jev.d.ts", "import": "./dist/providers/Jev.js" }
  },
  "types": "./dist/index.d.ts",
  "files": ["dist"],
  "scripts": {
    "example": "node examples/main.ts",
    "example:evidence": "node examples/evidence.ts",
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc --noEmit",
    "lint": "oxlint --deny-warnings",
    "format": "dprint fmt",
    "format:check": "dprint check",
    "check": "pnpm typecheck && pnpm lint && pnpm format:check"
  },
  "peerDependencies": { "effect": "^4.0.0-rc.115" },
  "devDependencies": {
    "@effect/platform-node": "4.0.0-rc.115",
    "effect": "4.0.0-rc.115",
    "@types/node": "^22.20.3",
    "dprint": "^0.57.4",
    "oxlint": "^1.83.0",
    "typescript": "^7.0.2"
  }
}
